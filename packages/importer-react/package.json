{
  "name": "@oneschema/react",
  "version": "0.7.7",
  "description": "React component for embedding OneSchema Importer",
  "author": "OneSchema",
  "license": "MIT",
  "main": "dist/main.js",
  "module": "dist/module.js",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/module.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/main.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "targets": {
    "main": false,
    "module": false,
    "types": false,
    "test": {
      "distDir": "./test/dist"
    }
  },
  "homepage": "https://www.oneschema.co/",
  "bugs": "https://github.com/oneschema/sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneschema/sdk.git",
    "directory": "packages/importer-react"
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "yarn run clean && rollup -c && node ../../scripts/dual-types.mjs dist/index.d.ts",
    "build-test": "parcel build test/index.html",
    "test": "parcel serve test/index.html -p 4243 --open",
    "test:ci": "true",
    "fix": "eslint './src/**/**.{ts,tsx,js,jsx}' --fix",
    "check": "eslint './src/**/**.{ts,tsx,js,jsx}' && tsc --noEmit",
    "clean": "npx --yes rimraf dist"
  },
  "dependencies": {
    "@oneschema/importer": "^0.7.7",
    "tslib": "^2.x"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^18.0.14",
    "@types/react-dom": "^18.0.5",
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "eslint": "^8.18.0",
    "eslint-import-resolver-typescript": "^3.1.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^5.2.1",
    "parcel": "^2.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.68.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": ">=17"
  }
}
