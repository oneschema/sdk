{
  "private": true,
  "workspaces": [
    "packages/importer",
    "packages/importer-react",
    "packages/filefeeds",
    "packages/filefeeds-react",
    "packages/importer-vue",
    "packages/importer-angular",
    "packages/importer-angular/projects/oneschema"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "clean": "yarn workspaces foreach -A run clean && rm -rf node_modules",
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "fix": "yarn docs:api && prettier --write . && yarn workspaces foreach -A run fix",
    "check": "node scripts/generate-api-docs.mjs --check && prettier --check . && htmlhint \"packages/**/test/*.html\" && yarn workspaces foreach -A run check",
    "check:packages": "node scripts/check-packages.mjs",
    "check:ranges": "node scripts/check-internal-ranges.mjs",
    "check:install": "node scripts/smoke-install.mjs",
    "test:ci": "yarn workspaces foreach -A run test:ci",
    "version:packages": "changeset version && yarn install --mode=update-lockfile",
    "release": "yarn build && yarn check:ranges && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@parcel/core": "2.8.3",
    "@parcel/transformer-vue": "2.8.3",
    "htmlhint": "1.9.2",
    "prettier": "3.9.6",
    "process": "^0.11.10",
    "publint": "0.3.24",
    "react": "^18.2.0",
    "semver": "7.7.4"
  },
  "resolutions": {
    "human-id": "4.1.3"
  }
}
